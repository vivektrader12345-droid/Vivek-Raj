{
  "name": "vivek-crypto-trader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "prebuild": "npm run generate:pwa-icons",
    "build": "vite build",
    "test:pwa": "npm run build && node --test tests/pwaInstallability.test.js",
    "test:pwa:static": "node --test --test-name-pattern=\"production manifest and icons\" tests/pwaInstallability.test.js",
    "test": "npm run build && node --test tests/firebaseAuthenticatedFetch.test.js tests/webhookApiConfig.test.js tests/pwaInstallability.test.js",
    "test:geometry:exploration": "node --test tests/geometry/terminalGeometry.exploration.test.js",
    "test:trade-history:exploration": "node --test tests/trade-history/tradeHistory.exploration.test.js",
    "test:trade-history:preservation": "node --test tests/trade-history/tradeHistory.preservation.test.js",
    "test:trade-history": "node --test tests/trade-history/tradeHistoryViewModel.test.js && npm run test:trade-history:exploration && npm run test:trade-history:preservation && npm run test:trade-history:route-artifact",
    "test:trade-history:route-artifact": "npm run build && node --test tests/trade-history/tradeHistory.routeArtifact.test.js",
    "test:preservation": "node --test tests/preservation/preservation.characterization.test.js",
    "test:terminal:styles": "node --test tests/terminal/scopedTerminal.test.js",
    "test:terminal:header": "node --test tests/terminal/terminalHeader.test.js",
    "test:terminal:portals": "node --test tests/terminal/portalPrimitives.test.js",
    "test:terminal:paper-quote": "node --test tests/terminal/paperQuoteFlow.test.js",
    "test:terminal:hud-safe-zones": "node --test tests/terminal/chartHudSafeZones.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "firebase": "^12.16.0",
    "lightweight-charts": "^4.1.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  }
}
