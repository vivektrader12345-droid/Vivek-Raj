{
  "name": "vivek-crypto-trader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "prebuild": "npm run generate:pwa-icons",
    "build": "vite build",
    "test:pwa": "npm run build && node --test tests/pwaInstallability.test.js",
    "test:pwa:static": "node --test --test-name-pattern=\"production manifest and icons\" tests/pwaInstallability.test.js",
    "test": "npm run build && node --test tests/firebaseAuthenticatedFetch.test.js tests/webhookApiConfig.test.js tests/pwaInstallability.test.js",
    "test:billing": "node --test tests/billingService.test.js tests/billingContracts.test.js tests/subscriptionEntitlements.test.js",
    "test:complimentary:unit": "node --test tests/billingService.test.js tests/subscriptionEntitlements.test.js tests/complimentaryPresentationRoutes.test.js tests/adminComplimentarySubscriptions.test.js",
    "test:complimentary:browser": "node --test tests/complimentaryAdminBrowser.test.js",
    "test:complimentary:bundle": "npm run build && node --test tests/complimentaryFrontendSecurity.test.js",
    "test:complimentary": "npm run test:complimentary:unit && npm run test:complimentary:browser && npm run test:complimentary:bundle",
    "test:backend": "python -m unittest discover -s backend/tests -t backend -p \"test_*.py\"",
    "test:firestore": "firebase emulators:exec --only auth,firestore --project demo-complimentary-billing \"npm run test:firestore:emulator\"",
    "test:firestore:emulator": "node --test --test-concurrency=1 tests/firestoreBillingSecurity.test.js && python -m unittest discover -s backend/tests -t backend -p \"test_billing_firestore_*_emulator.py\"",
    "test:geometry:exploration": "node --test tests/geometry/terminalGeometry.exploration.test.js",
    "test:trade-history:exploration": "node --test tests/trade-history/tradeHistory.exploration.test.js",
    "test:trade-history:preservation": "node --test tests/trade-history/tradeHistory.preservation.test.js",
    "test:trade-history": "node --test tests/trade-history/tradeHistoryViewModel.test.js && npm run test:trade-history:exploration && npm run test:trade-history:preservation && npm run test:trade-history:route-artifact",
    "test:trade-history:route-artifact": "npm run build && node --test tests/trade-history/tradeHistory.routeArtifact.test.js",
    "test:preservation": "node --test tests/preservation/preservation.characterization.test.js",
    "test:terminal:styles": "node --test tests/terminal/scopedTerminal.test.js",
    "test:terminal:header": "node --test tests/terminal/terminalHeader.test.js",
    "test:terminal:portals": "node --test tests/terminal/portalPrimitives.test.js",
    "test:terminal:paper-quote": "node --test tests/terminal/paperQuoteFlow.test.js",
    "test:terminal:hud-safe-zones": "node --test tests/terminal/chartHudSafeZones.test.js",
    "android:sync": "node scripts/sync-android.mjs",
    "android:gradle": "node scripts/run-android-gradle.mjs",
    "scan:release-secrets": "node scripts/scan-release-secrets.mjs --staged",
    "test:android-release-security": "node --test tests/androidReleaseSecurity.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@emailjs/browser": "^4.4.1",
    "firebase": "^12.16.0",
    "lightweight-charts": "^4.1.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "firebase-tools": "15.28.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  }
}
