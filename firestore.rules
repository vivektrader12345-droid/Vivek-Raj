// Firestore Security Rules
// Password sessions must present a server-issued OTP proof for their current login.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasCurrentOtpProof() {
      return request.auth.token.firebase.sign_in_provider == 'google.com'
        || (request.auth.token.firebase.sign_in_provider == 'password'
          && 'otp_auth_time' in request.auth.token
          && request.auth.token.otp_auth_time == request.auth.token.auth_time);
    }

    function isAuthorizedOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && hasCurrentOtpProof();
    }

    match /users/{userId} {
      allow read, write: if isAuthorizedOwner(userId);

      match /{subcollection}/{docId} {
        allow read, write: if isAuthorizedOwner(userId);
      }

      match /data/{docId} {
        allow read, write: if isAuthorizedOwner(userId);
      }
    }

    // OTP challenges are accessible only through the Firebase Admin backend.
    match /otp_challenges/{userId} {
      allow read, write: if false;
    }

    // Deny the retired client-controlled OTP collection explicitly.
    match /otps/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
