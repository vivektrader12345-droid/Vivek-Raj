// Firestore Security Rules
// Password sessions must present a server-issued OTP proof for their current login.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasCurrentOtpProof() {
      return request.auth.token.firebase.sign_in_provider == 'google.com'
        || (request.auth.token.firebase.sign_in_provider == 'password'
          && 'otp_auth_time' in request.auth.token
          && request.auth.token.otp_auth_time == request.auth.token.auth_time);
    }

    function isAuthorizedOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && hasCurrentOtpProof();
    }

    function isAuthorizedTradeExtension(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && 'extension_session' in request.auth.token
        && request.auth.token.extension_session == true;
    }

    match /users/{userId} {
      allow read, write: if isAuthorizedOwner(userId);

      match /trades/{docId} {
        allow read, write: if isAuthorizedOwner(userId);
        allow write: if isAuthorizedTradeExtension(userId);
      }

      match /{subcollection}/{docId} {
        allow read, write: if isAuthorizedOwner(userId);
      }

      match /data/{docId} {
        allow read, write: if isAuthorizedOwner(userId);
      }
    }

    // OTP challenges are accessible only through the Firebase Admin backend.
    match /otp_challenges/{userId} {
      allow read, write: if false;
    }

    // Deny the retired client-controlled OTP collection explicitly.
    match /otps/{document=**} {
      allow read, write: if false;
    }

    // Canonical billing state is Admin-SDK-only. Keep these explicit even
    // though the final catch-all also denies unknown top-level collections.
    match /billing_coupons/{document=**} {
      allow read, write: if false;
    }
    match /billing_coupon_user_usage/{document=**} {
      allow read, write: if false;
    }
    match /billing_orders/{document=**} {
      allow read, write: if false;
    }
    match /billing_provider_orders/{document=**} {
      allow read, write: if false;
    }
    match /billing_payments/{document=**} {
      allow read, write: if false;
    }
    match /billing_payment_attempts/{document=**} {
      allow read, write: if false;
    }
    match /billing_subscriptions/{document=**} {
      allow read, write: if false;
    }
    match /billing_coupon_redemptions/{document=**} {
      allow read, write: if false;
    }
    match /billing_webhook_events/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
