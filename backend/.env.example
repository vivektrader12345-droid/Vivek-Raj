# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Trading Settings (fail closed by default)
AUTO_TRADE_ENABLED=false
CONNECT_EXCHANGE_ON_STARTUP=false
# Required when startup credentials are enabled; binds them to exactly one Firebase UID.
STARTUP_EXCHANGE_USER_ID=
WEBHOOK_LIVE_EXECUTION_ENABLED=false
LEGACY_WEBHOOK_LIVE_ENABLED=false
# Bare /webhook compatibility route is off unless explicitly enabled and authenticated.
LEGACY_ROUTES_ENABLED=false
LEGACY_WEBHOOK_SECRET=replace_with_a_random_legacy_compatibility_secret
DEFAULT_TRADE_AMOUNT_USDT=10
DEFAULT_LEVERAGE=1
USE_TESTNET=true

# Server
PORT=5000
WEBHOOK_BASE_URL=http://localhost:5000

# Firebase Admin (server-only; credentials stay outside the repository)
FIREBASE_PROJECT_ID=vivek-crypto-trader-b8d19
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json

# Webhook Security (set a secret and use same in TradingView alert message)
WEBHOOK_SECRET=your_secret_key_here

# Server-side email OTP (OTP_HMAC_SECRET must be at least 32 random characters)
OTP_HMAC_SECRET=replace_with_a_cryptographically_random_secret
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Optional server-only EmailJS Private Key. Required when non-browser API calls are restricted.
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Razorpay billing (server-only; never expose secrets to Vite/client code)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
# Comma-separated verified Firebase emails allowed to administer billing.
BILLING_ADMIN_EMAILS=admin@example.com
BILLING_CHECKOUT_TTL_MINUTES=20
BILLING_ALLOW_ZERO_AMOUNT=false
# Optional validated JSON override. Amounts are paise, not INR.
# BILLING_PLANS_JSON=[{"id":"basic","name":"Basic","amountPaise":49900,"durationDays":30,"features":["Trading dashboard"]}]
